        "content": {
          "freetext": {
            "notes": [
              {
                "label": "Description",
                "content": "When this large orchid first hit the European orchid scene in the late 1800s, it was so coveted that thousands were taken from its native Guatemalan cloud forests and exported. Almost all of these plants died for various reasons. By the 1930s, when L. skinneri var. alba (now L. virginalis) was first designated as the national flower of Guatemala, it was considered rare. Despite prohibition on the collection of L. virginalis starting in the 1940s, poaching continued, leading to the Guatemalan government banning the export of all orchids until the ‘90s. This beautiful orchid remains in danger, but protection efforts persist."
              },
              {
                "label": "Bloom Time (Northern Hemisphere)",
                "content": "Year round; peaks in February and March"
              },
              {
                "label": "Ethnobotanical Uses",
                "content": "National flower of Guatemala."
              },
              {
                "label": "Pollination Syndrome",
                "content": "Bee (Euglossa), collects fragrance"
              },
              {
                "label": "Provenance",
                "content": "From a cultivated plant not of known wild origin"
              }
            ],
            "place": [
              {
                "label": "Range",
                "content": "Mexico (Chiapas) to Honduras"
              },
              {
                "label": "Habitat",
                "content": "Cool cloud forests in the forks of trees; 3950-6600ft (1200-2000m)"
              }
            ],
            "topic": [
              {
                "label": "Topic",
                "content": "Orchids"
              },
