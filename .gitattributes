*.glb binary
*.webp binary
*.woff2 binary
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Keep captured license/source evidence byte-for-byte.
sources/** -text -whitespace
models/**/source.json -text -whitespace
models/**/original/** -text -whitespace
kits/** -text -whitespace

# Keep vendored sources and locked audit evidence byte-for-byte across platforms.
creation-lab/vendor/** -text -whitespace
creation-lab/registry/** -text -whitespace
.agents/skills/blender-codex-recipes/** -text
.agents/skills/blender-lpm-recipes/** -text
*.csv text eol=lf

# Frozen benchmark generators and their evidence retain original bytes.
creation-lab/benchmarks/** -text -whitespace

# Experiments keep their generators, receipts and hashed evidence byte-for-byte.
creation-lab/experiments/** -text -whitespace

# Studio TypeScript and ESM sources are portable across Windows and WSL.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
