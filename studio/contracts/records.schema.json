{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gg3d:studio:records:1",
  "title": "GG3D Studio records v1",
  "description": "Structural schema. studio.core additionally validates path confinement, hashes, finite numbers, unique IDs, hierarchy and track ownership.",
  "type": "object",
  "required": ["schemaVersion", "kind", "id"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"enum": ["project", "asset", "rig", "motion", "scene", "run", "package"]},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,95}$"}
  },
  "allOf": [
    {"if":{"properties":{"kind":{"const":"scene"}}},"then":{"required":["title","duration","mode","instances"],"properties":{"title":{"type":"string","minLength":1},"duration":{"type":"number","exclusiveMinimum":0,"maximum":300},"mode":{"enum":["interactive","timeline"]},"instances":{"type":"array","minItems":1,"maxItems":1000,"items":{"type":"object","required":["id","asset","position","rotation","scale"],"properties":{"id":{"type":"string"},"asset":{"type":"string","minLength":1},"position":{"$ref":"#/$defs/vector"},"rotation":{"$ref":"#/$defs/vector"},"scale":{"$ref":"#/$defs/positiveVector"}}}},"tracks":{"type":"array","items":{"type":"object","required":["target","channel","keyframes"],"properties":{"target":{"type":"string"},"channel":{"enum":["pressed","angle"]},"keyframes":{"type":"array","minItems":1,"items":{"type":"object","required":["time","value"],"properties":{"time":{"type":"number","minimum":0},"value":{"type":"number"}}}}}}}}}},
    {"if":{"properties":{"kind":{"const":"project"}}},"then":{"required":["title","scene","files","provenance"],"properties":{"title":{"type":"string"},"scene":{"type":"string"},"files":{"$ref":"#/$defs/inventory"},"provenance":{"$ref":"#/$defs/provenance"}}}},
    {"if":{"properties":{"kind":{"const":"asset"}}},"then":{"required":["revision","artifacts","coordinates","bounds","provenance","capabilities"],"properties":{"revision":{"type":"string"},"artifacts":{"$ref":"#/$defs/inventory"},"coordinates":{"$ref":"#/$defs/coordinates"},"bounds":{"$ref":"#/$defs/positiveVector"},"provenance":{"$ref":"#/$defs/provenance"},"capabilities":{"type":"array","items":{"type":"string"}}}}},
    {"if":{"properties":{"kind":{"const":"rig"}}},"then":{"required":["asset","skeletonHash","joints","coordinates","provenance"],"properties":{"asset":{"type":"string"},"skeletonHash":{"$ref":"#/$defs/hash"},"joints":{"type":"array","minItems":1,"items":{"type":"object","required":["name","parent"],"properties":{"name":{"type":"string"},"parent":{"type":["string","null"]}}}},"coordinates":{"$ref":"#/$defs/coordinates"},"provenance":{"$ref":"#/$defs/provenance"}}}},
    {"if":{"properties":{"kind":{"const":"motion"}}},"then":{"required":["skeletonHash","duration","sampleRate","rootMotion","artifacts","provenance"],"properties":{"skeletonHash":{"$ref":"#/$defs/hash"},"duration":{"type":"number","exclusiveMinimum":0},"sampleRate":{"type":"number","exclusiveMinimum":0,"maximum":240},"rootMotion":{"enum":["in-place","world"]},"artifacts":{"$ref":"#/$defs/inventory"},"provenance":{"$ref":"#/$defs/provenance"}}}},
    {"if":{"properties":{"kind":{"const":"run"}}},"then":{"required":["operation","inputs","createdAt","gates"],"properties":{"operation":{"type":"string"},"inputs":{"type":"object"},"createdAt":{"type":"string"},"gates":{"$ref":"#/$defs/gates"}}}},
    {"if":{"properties":{"kind":{"const":"package"}}},"then":{"required":["files","reviews"],"properties":{"files":{"$ref":"#/$defs/inventory"},"reviews":{"type":"object","required":["technical","visual","content","provenance"],"additionalProperties":{"type":"object","required":["status","path","sha256"],"properties":{"status":{"const":"PASS"},"path":{"type":"string"},"sha256":{"$ref":"#/$defs/hash"}}}}}}}
  ],
  "$defs": {
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "vector":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
    "positiveVector":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","exclusiveMinimum":0}},
    "inventory":{"type":"array","minItems":1,"items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/hash"}}}},
    "coordinates":{"type":"object","required":["units","up","front"],"properties":{"units":{"enum":["m","mm"]},"up":{"enum":["X","Y","Z"]},"front":{"enum":["+X","-X","+Y","-Y","+Z","-Z"]}}},
    "provenance":{"type":"object","required":["author","license","source"],"properties":{"author":{"type":"string","minLength":1},"license":{"type":"string","minLength":1},"source":{"type":"string","minLength":1}}},
    "gates":{"type":"object","required":["technical","visual","content","provenance"],"additionalProperties":{"enum":["PASS","FAIL","BLOCKED","NOT_RUN"]}}
  }
}
