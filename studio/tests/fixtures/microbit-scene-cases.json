{
  "description": "Shared scene-validation cases for the micro:bit channel contract. TypeScript (studio/web/tests/runtime.test.ts) and Python (studio/core.py) must accept every valid case and reject every invalid case. Each case is a complete minimal scene under 'scene'.",
  "contract": {
    "channels": {
      "a|b|logo": "0..1, only on instances with behavior 'microbit'",
      "led.X.Y": "X column, Y row, each 0..4, origin top-left, value 0..255, only on behavior 'microbit'",
      "pressed": "0..1, button instances only",
      "angle": "-180..180, servo instances only"
    },
    "behavior": "optional; only the value 'microbit'; only on an asset whose path ends in .glb",
    "patternBindings": "optional array of at most 100; object with exactly keys source,target,released,pressed; source in a|b|logo; target a microbit instance; (source,target) unique; released and pressed are 5 rows (y) of 5 columns (x) of finite numbers 0..255"
  },
  "valid": [
